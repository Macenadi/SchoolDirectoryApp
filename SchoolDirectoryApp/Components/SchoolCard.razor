@using SchoolDirectoryApp.Models

<div class="card mb-3">
    <div class="card-body">

        <h5 class="card-title">
            @School.SchoolName
        </h5>

        <p class="card-text">
            @School.Address
        </p>

        <button class="btn btn-primary"
                @onclick="SelectSchool">
            @(IsSelected ? "Hide Details" : "View Details")
        </button>

        <button class="btn btn-outline-warning ms-2"
                @onclick="ToggleFavourite">
            @(IsFavourite ? "★ Remove Favourite" : "☆ Add Favourite")
        </button>

    </div>
</div>

@code {
    [Parameter]
    public School School { get; set; } = new School();

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public bool IsFavourite { get; set; }

    [Parameter]
    public EventCallback<School> OnFavouriteToggle { get; set; }

    [Parameter]
    public EventCallback<School> OnSelect { get; set; }

    private async Task SelectSchool()
    {
        await OnSelect.InvokeAsync(School);
    }

    private async Task ToggleFavourite()
    {
        await OnFavouriteToggle.InvokeAsync(School);
    }
}