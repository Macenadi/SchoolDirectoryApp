@page "/schools"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using SchoolDirectoryApp.Models
@using SchoolDirectoryApp.Services

@inject SchoolService SchoolService

<div class="mb-4">
    <h2 class="fw-bold text-primary">School Directory</h2>
    <p class="text-muted">
        Explore, search and manage your favourite schools.
    </p>
</div>

    <div class="row g-3 mb-3">

    <div class="col-12 col-md-8">
        <label class="form-label">Search Schools</label>

        <input type="text"
               class="form-control"
               placeholder="Search schools by name..."
               @bind="searchText"
               @bind:event="oninput" />
    </div>

    <div class="col-12 col-md-4">
        <label class="form-label">Sort schools by name</label>

        <select class="form-select" @bind="sortOrder">
            <option value="asc">Name (A-Z)</option>
            <option value="desc">Name (Z-A)</option>
        </select>
    </div>

</div>

<div class="form-check mb-3">
    <input class="form-check-input"
           type="checkbox"
           id="favouritesOnly"
           @bind="showFavouritesOnly" />

    <label class="form-check-label" for="favouritesOnly">
        Show Favourites Only
    </label>
</div>


<div class="mb-3">
    <button class="btn btn-success"
            @onclick="LoadSchools">
        Refresh Schools
    </button>
</div>

@if (!error && schools != null)
{
    <div class="row mb-4">

        <div class="col-md-4 mb-3">
            <div class="card text-center border-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Schools</h5>
                    <h2 class="text-primary">@TotalSchools</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card text-center border-warning">
                <div class="card-body">
                    <h5 class="card-title">Favourite Schools</h5>
                    <h2 class="text-warning">@TotalFavourites</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card text-center border-success">
                <div class="card-body">
                    <h5 class="card-title">Schools Displayed</h5>
                    <h2 class="text-success">@DisplayedSchools</h2>
                </div>
            </div>
        </div>

    </div>
}



@if (error)
{
    <p class="text-danger">
        Unable to retrieve school data.
    </p>
}
else if (schools == null)
{
    <p>Loading schools...</p>
}

else
{
    
    @if (!filteredSchools.Any())
{
    <p>No schools found.</p>
}
else
{
        @foreach (var school in filteredSchools)
        {
            <SchoolCard School="school"
                        OnSelect="SelectSchool"
                        IsSelected="@(selectedSchool?.SchoolId == school.SchoolId)"
                        IsFavourite="@favouriteSchoolIds.Contains(school.SchoolId)"
                        OnFavouriteToggle="ToggleFavourite" />

            @if (selectedSchool?.SchoolId == school.SchoolId)
            {
                <SchoolDetails School="school" />
            }
        }
}
}

@code {

    private List<School>? schools;
    private School? selectedSchool;
    private void ToggleFavourite(School school)
    {
        if (favouriteSchoolIds.Contains(school.SchoolId))
        {
            favouriteSchoolIds.Remove(school.SchoolId);
        }
        else
        {
            favouriteSchoolIds.Add(school.SchoolId);
        }
    }
    private string searchText = "";
    private string sortOrder = "asc";
    private bool showFavouritesOnly = false;
    private HashSet<int> favouriteSchoolIds = new();
    private bool error = false;
    private int TotalSchools => schools?.Count ?? 0;
    private int TotalFavourites => favouriteSchoolIds.Count;
    private int DisplayedSchools => filteredSchools.Count();

    private IEnumerable<School> filteredSchools =>
    (sortOrder == "asc"
        ? (schools ?? new List<School>())
            .Where(s =>
                s.SchoolName?.Contains(
                    searchText,
                    StringComparison.OrdinalIgnoreCase) == true
                && (!showFavouritesOnly ||
                    favouriteSchoolIds.Contains(s.SchoolId)))
            .OrderBy(s => s.SchoolName)
        : (schools ?? new List<School>())
            .Where(s =>
                s.SchoolName?.Contains(
                    searchText,
                    StringComparison.OrdinalIgnoreCase) == true
                && (!showFavouritesOnly ||
                    favouriteSchoolIds.Contains(s.SchoolId)))
            .OrderByDescending(s => s.SchoolName));

    protected override async Task OnInitializedAsync()
    {
        await LoadSchools();
    }

    private async Task LoadSchools()
    {
        try
        {
            error = false;
            schools = null;
            selectedSchool = null;

            schools = await SchoolService.GetSchoolsAsync();

            if (schools == null)
            {
                error = true;
            }
        }
        catch (Exception)
        {
            error = true;
        }
    }

    private void SelectSchool(School school)
    {
        if (selectedSchool?.SchoolId == school.SchoolId)
        {
            selectedSchool = null;
        }
        else
        {
            selectedSchool = school;
        }
    }
}